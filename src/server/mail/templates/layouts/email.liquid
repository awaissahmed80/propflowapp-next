{%- comment -%}
  Shared frame for every PropFlow email: logo, content, dashed-line footer.
  Tables and inline styles only, so Gmail, Outlook and Apple Mail show it the same.
  Styles live in `style` (see render.js) so the look can change in one place.
{%- endcomment -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light only">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#ffffff;">
{%- if preheader %}
<div data-preheader style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">{{ preheader }}</div>
{%- endif %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;">
<tr><td align="center" style="padding:48px 24px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
  <tr><td style="padding:0 0 40px;">
    <img src="{{ logo_src }}" width="175" height="36" alt="PropFlow" style="display:block;border:0;outline:none;height:36px;width:auto;">
  </td></tr>
  <tr><td>
{% block content %}{% endblock %}
  </td></tr>
  <tr><td style="padding:48px 0 0;">
    <div style="border-top:1px dashed #d1d5db;padding-top:20px;{{ style.small }}">
      © {{ year }} PropFlow · Real estate ERP for Pakistan<br>
      <a href="https://propflowapp.com" style="color:{{ color.muted }};text-decoration:underline;">propflowapp.com</a>
    </div>
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
