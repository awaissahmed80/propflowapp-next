# PropFlow environment
# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -base64 32

# ---------- App ----------
APP_ENV=development
# Root domain; subdomains are auth., portal., console. and campaigns.
ROOT_DOMAIN=propflowapp.test
NEXT_PUBLIC_ROOT_DOMAIN=propflowapp.test
APP_PROTOCOL=https
# Shared cookie domain so one sign-in works on every subdomain (leading dot)
COOKIE_DOMAIN=.propflowapp.test

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=false
# App user: read/write on pf_% databases only
DB_USER=
DB_PASSWORD=
# Central databases
DB_PLATFORM_NAME=pf_platform
DB_AUTH_NAME=pf_auth
# Each subscriber gets pf_ + their permanent tenant code, e.g. pf_ten00042
DB_TENANT_PREFIX=pf_
# Provisioning user: can CREATE DATABASE for new tenants (used by signup and CLI only)
DB_PROVISION_USER=
DB_PROVISION_PASSWORD=
# Connection pools (per central database / per tenant database)
DB_POOL_MAX=10
DB_TENANT_POOL_MAX=5

# ---------- Sessions & security ----------
SESSION_COOKIE_NAME=pf_session
SESSION_TTL_DAYS=30
# Signs session and CSRF tokens
SESSION_SECRET=
# Encrypts stored secrets (integration tokens, bank details at rest)
ENCRYPTION_KEY=
# Sign-up and password-reset codes
OTP_TTL_MINUTES=10
# Protects scheduled-job routes (reminders, expiries, recycle-bin purge)
CRON_SECRET=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
# Must be a domain verified in Resend
MAIL_FROM="PropFlow <no-reply@propflowapp.com>"
MAIL_REPLY_TO=support@propflowapp.com
# Where website enquiries (demo, sales, trial requests) are emailed; leave empty to skip
SALES_NOTIFY_EMAIL=
# Optional: verifies delivery/bounce webhooks from Resend
RESEND_WEBHOOK_SECRET=

# ---------- Sign in with Google ----------
# Used on sign-in, accepting invitations and (later) self sign-up. Create an OAuth client
# (type "Web application") in Google Cloud Console → APIs & Services → Credentials and add
# GOOGLE_REDIRECT_URI below as an "Authorised redirect URI".
# Google only accepts public domains or localhost, not .test, so local development uses
# localhost: that address hands the sign-in straight on to https://auth.<ROOT_DOMAIN>.
# Production: https://auth.propflowapp.com/api/auth/google/callback
# Leave the client ID empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5190/api/auth/google/callback

# ---------- Facebook & Instagram lead ads (Campaigns › Integrations) ----------
# A Meta app (developers.facebook.com) with Facebook Login for Business and Webhooks.
#   Valid OAuth redirect URI: https://portal.<ROOT_DOMAIN>/api/meta/callback
#   (or https://portal.<ROOT_DOMAIN>/settings/integrations/meta/callback, set as META_REDIRECT_URI)
#   Webhooks › Page › subscribe to "leadgen", callback https://portal.<ROOT_DOMAIN>/api/meta/webhook
#   with META_WEBHOOK_VERIFY_TOKEN (any long random string). Meta must reach the webhook, so in
#   development use a tunnel (e.g. cloudflared) to the dev server.
# Permissions: pages_show_list, pages_read_engagement, pages_manage_metadata, pages_manage_ads,
# leads_retrieval, business_management (App Review needed before other businesses can connect).
# Leave the app ID empty to show "not set up" on the Integrations page.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Optional: Graph API version, Facebook Login return address (must match the app's setting exactly)
# and scopes (comma-separated) replacing the list above
META_GRAPH_VERSION=v23.0
META_REDIRECT_URI=
META_SCOPES=

# ---------- File storage ----------
# local (disk) or s3 (any S3-compatible: Cloudflare R2, DigitalOcean Spaces, AWS)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# STORAGE_DRIVER=s3 keeps files in an S3-compatible bucket instead (AWS S3, DigitalOcean Spaces,
# Cloudflare R2, Wasabi, MinIO). The bucket stays private; copy existing files with `yarn storage:copy`.
#   DigitalOcean Spaces: S3_REGION=sgp1  S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
#   Cloudflare R2:       S3_REGION=auto  S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   AWS S3:              S3_REGION=ap-south-1 (leave S3_ENDPOINT empty)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for files served from the bucket, if any
S3_PUBLIC_URL=

# ---------- Platform owner (first console account, created by the platform seeder) ----------
PLATFORM_OWNER_NAME=
PLATFORM_OWNER_EMAIL=
# Leave empty to have the seeder print a one-time password
PLATFORM_OWNER_PASSWORD=

# ---------- Later: subscription payments ----------
# PAYMENT_MODE=sandbox
# Online payment gateways. A gateway can only be switched on in the console
# (Payment Methods) once all its keys are set here.
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=
# PAYFAST_MERCHANT_ID=
# PAYFAST_SECURED_KEY=

# ---------- Analytics ----------
# Google Analytics 4 for the public website only (not a secret: it is visible in the page).
# Used when APP_ENV=production and Console → Settings → Website analytics is empty.
GA_MEASUREMENT_ID=
# Console Overview → Website: reads the numbers back with the free GA Data API. A Google Cloud
# service account with Viewer access on the property; values from its JSON key file.
GA_PROPERTY_ID=
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=
# Leads (generate_lead) are sent from the server so ad blockers can't hide them:
# GA → Admin → Data streams → your stream → Measurement Protocol API secrets → Create
GA_API_SECRET=

# Cloudflare Turnstile captcha on public lead forms (campaigns.<domain>). Without them, development
# uses Cloudflare's always-pass test keys and production accepts entries unchecked.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_VERSION=
META_SCOPES=
META_WEBHOOK_VERIFY_TOKEN=
